# Normalise all text to LF in the repo; checkout native on Windows.
* text=auto eol=lf

# Never let these become CRLF - they run inside Linux containers.
*.sh          text eol=lf
Dockerfile    text eol=lf
Makefile      text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# Binary / LFS
*.png  binary
*.jpg  binary
*.pdf  binary
*.parquet filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.gguf filter=lfs diff=lfs merge=lfs -text
*.bin  filter=lfs diff=lfs merge=lfs -text
